# ─────────────────────────────────────────────────
# High School Management System — Environment Config
# Copy this file to .env and fill in your values
# NEVER commit .env to Git
# ─────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=5000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=highschool_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# JWT Secrets (generate strong random strings for production)
JWT_ACCESS_SECRET=change_this_to_a_long_random_secret_access_key_min_64_chars
JWT_REFRESH_SECRET=change_this_to_a_long_random_secret_refresh_key_min_64_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS - allowed frontend origin
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Cookie
COOKIE_SECRET=change_this_to_a_random_cookie_secret_key
